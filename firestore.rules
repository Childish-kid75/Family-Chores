rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these Google accounts can read or write chores.
    // Replace the emails below with your family's Gmail addresses.
    match /chores/{id} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'YOUR-EMAIL@gmail.com',
          'nmathenjwa85@gmail.com',
          'MOM-EMAIL@gmail.com',
          'DAD-EMAIL@gmail.com'
        ];
    }
  }
}
